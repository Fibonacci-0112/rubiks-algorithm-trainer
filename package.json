{
  "name": "rubiks-algo-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D Rubik's Cube algorithm trainer",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate:seed": "pnpm --filter @rubiks/core validate:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
